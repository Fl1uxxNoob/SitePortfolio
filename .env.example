# Configurazione SMTP per l'invio delle email del form di contatto.
# Copia questo file in ".env" e inserisci i valori reali.
# Provider: register.it (modifica host/porta se il tuo pannello indica valori diversi).

# register.it gestisce la posta sulla piattaforma securemail.pro
SMTP_HOST=smtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true

# Casella mittente del dominio usata per autenticarsi sull'SMTP (creala su register.it)
SMTP_USER=noreply@fl1uxxservices.it
SMTP_PASS=la-password-della-casella

# Destinatario dei messaggi del form
CONTACT_TO=contact@fl1uxxservices.it

# Mittente mostrato nell'email (di default uguale a SMTP_USER se lasciato vuoto)
CONTACT_FROM=noreply@fl1uxxservices.it
